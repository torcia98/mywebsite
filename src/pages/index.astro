---
import Base from '../layouts/Base.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
import { localizedPath } from '../i18n/ui';

const benefits = [
  { value: '10+', label: 'ore risparmiate a settimana per persona, in media*' },
  { value: '2–4', label: 'settimane per mettere in produzione la prima automazione' },
  { value: '100%', label: 'dati trattati nel rispetto del GDPR, su server UE' },
];

const steps = [
  { n: '01', title: 'Analisi gratuita', text: 'Capiamo come lavorate e dove si perde più tempo.' },
  { n: '02', title: 'Progetto pilota', text: 'Partiamo da un caso concreto, con costi e risultati chiari.' },
  { n: '03', title: 'Messa in opera', text: 'Integriamo l’automazione nei vostri strumenti e formiamo il team.' },
  { n: '04', title: 'Miglioramento continuo', text: 'Misuriamo i risultati e ottimizziamo nel tempo.' },
];
---

<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
    <div class="container-page grid items-center gap-12 py-20 lg:grid-cols-2 lg:py-28">
      <div>
        <p class="eyebrow">AI e automazione per le PMI</p>
        <h1 class="mt-3 text-4xl leading-tight sm:text-5xl lg:text-6xl">
          Meno lavoro ripetitivo, <span class="text-brand-600">più tempo per i clienti.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-slate-600">
          Aiutiamo piccole e medie imprese italiane a usare l’intelligenza artificiale in modo semplice e concreto:
          assistenti che rispondono ai clienti, documenti che si compilano da soli, processi che girano senza intoppi.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={localizedPath('it', 'contact') + '#prenota'} class="btn btn-primary">Prenota un’analisi gratuita</a>
          <a href={localizedPath('it', 'services')} class="btn btn-secondary">Scopri i servizi</a>
        </div>
        <p class="mt-4 text-sm text-slate-500">Nessun impegno. Ti rispondiamo entro un giorno lavorativo.</p>
      </div>

      <!-- Illustrative mock chat (placeholder visual) -->
      <div class="relative mx-auto w-full max-w-md" aria-hidden="true">
        <div class="absolute -inset-6 -z-10 rounded-[2rem] bg-brand-100/60 blur-2xl"></div>
        <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-xl">
          <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
            <span class="size-9 rounded-full bg-brand-600"></span>
            <div>
              <p class="text-sm font-semibold">Assistente • Ferramenta Rossi</p>
              <p class="text-xs text-emerald-600">online</p>
            </div>
          </div>
          <div class="space-y-3 pt-4 text-sm">
            <p class="ml-auto w-fit max-w-[80%] rounded-2xl rounded-br-sm bg-brand-600 px-4 py-2 text-white">Buongiorno, siete aperti sabato pomeriggio?</p>
            <p class="w-fit max-w-[85%] rounded-2xl rounded-bl-sm bg-slate-100 px-4 py-2">Buongiorno! Sabato siamo aperti dalle 9 alle 13. Vuole che le prenoti un ritiro per lunedì mattina?</p>
            <p class="ml-auto w-fit max-w-[80%] rounded-2xl rounded-br-sm bg-brand-600 px-4 py-2 text-white">Sì grazie, alle 9:30</p>
            <p class="w-fit max-w-[85%] rounded-2xl rounded-bl-sm bg-slate-100 px-4 py-2">Fatto ✅ Le ho inviato la conferma. A lunedì!</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="container-page">
    <dl class="grid gap-6 rounded-3xl border border-slate-200 p-8 sm:grid-cols-3">
      {
        benefits.map((b) => (
          <div>
            <dt class="text-4xl font-semibold text-brand-700">{b.value}</dt>
            <dd class="mt-1 text-sm text-slate-600">{b.label}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-3 text-xs text-slate-400">* Valori indicativi di esempio, da sostituire con dati reali.</p>
  </section>

  <!-- Services -->
  <section class="container-page mt-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Servizi</p>
      <h2 class="mt-2 text-3xl sm:text-4xl">Tre aree, un unico obiettivo: far lavorare meglio la vostra azienda</h2>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        services.map((s) => (
          <a
            href={`${localizedPath('it', 'services')}#${s.id}`}
            class="group rounded-3xl border border-slate-200 p-7 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg"
          >
            <ServiceIcon name={s.icon} />
            <h3 class="mt-5 text-xl">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.short}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-brand-700 group-hover:underline">Scopri di più →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Method -->
  <section class="mt-24 bg-slate-50 py-20">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Come lavoriamo</p>
        <h2 class="mt-2 text-3xl sm:text-4xl">Semplice, graduale, misurabile</h2>
        <p class="mt-4 text-slate-600">
          Niente progetti infiniti: partiamo da un problema reale e lo risolviamo in poche settimane.
        </p>
      </div>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <li class="rounded-2xl bg-white p-6 shadow-sm">
              <span class="text-sm font-semibold text-accent-600">{s.n}</span>
              <h3 class="mt-2 text-lg">{s.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <a href={localizedPath('it', 'method')} class="btn btn-secondary mt-8">Il nostro metodo</a>
    </div>
  </section>

  <!-- Testimonial placeholder -->
  <section class="container-page mt-24">
    <figure class="mx-auto max-w-3xl text-center">
      <blockquote class="text-2xl leading-snug font-medium text-slate-900">
        “Prima passavamo i lunedì mattina a registrare fatture. Adesso lo fa il sistema e noi controlliamo solo le eccezioni.”
      </blockquote>
      <figcaption class="mt-5 text-sm text-slate-500">Nome Cognome, Titolare · Azienda di esempio (testimonianza segnaposto)</figcaption>
    </figure>
  </section>

  <CtaBand />
</Base>
