---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services';
---

<Base
  title="Servizi"
  description="Assistenti AI e WhatsApp, automazione di documenti e fatture, flussi CRM ed email per PMI italiane."
>
  <PageHeader
    eyebrow="Servizi"
    title="Automazioni AI pensate per come lavora davvero una PMI"
    intro="Soluzioni pronte da adattare, non software da reinventare. Ci integriamo con gli strumenti che usate già: gestionale, email, WhatsApp, fogli di calcolo, CRM."
  />

  <nav class="container-page mt-10 flex flex-wrap gap-2" aria-label="Servizi">
    {services.map((s) => <a href={`#${s.id}`} class="btn btn-secondary">{s.title}</a>)}
  </nav>

  <div class="container-page mt-6 divide-y divide-slate-200">
    {
      services.map((s) => (
        <section id={s.id} class="grid scroll-mt-24 gap-10 py-16 lg:grid-cols-5">
          <div class="lg:col-span-2">
            <ServiceIcon name={s.icon} />
            <h2 class="mt-5 text-3xl">{s.title}</h2>
            <p class="mt-4 text-slate-600">{s.description}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {s.outcomes.map((o) => (
                <li class="rounded-full bg-brand-50 px-3 py-1 text-sm font-medium text-brand-800">{o}</li>
              ))}
            </ul>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-slate-50 p-7 lg:col-span-3">
            <h3 class="text-lg">Esempi di cosa possiamo automatizzare</h3>
            <ul class="mt-4 space-y-3">
              {s.examples.map((e) => (
                <li class="flex gap-3 text-slate-700">
                  <svg class="mt-1 size-5 shrink-0 text-brand-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" />
                  </svg>
                  <span>{e}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <section class="container-page mt-8">
    <div class="rounded-3xl border border-slate-200 p-8">
      <h2 class="text-2xl">Non trovate quello che cercate?</h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Ogni azienda ha i suoi processi. Se c’è un’attività ripetitiva che vi porta via tempo, probabilmente si può
        automatizzare: raccontatecela e vi diciamo onestamente se e come.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>
