---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import CtaBand from '../components/CtaBand.astro';
import DemoChat from '../components/demos/DemoChat.astro';
import DemoFlow from '../components/demos/DemoFlow.astro';
import DemoDocs from '../components/demos/DemoDocs.astro';
import DemoContent from '../components/demos/DemoContent.astro';
import { services } from '../data/services';
import { localizedPath } from '../i18n/ui';
---

<Base title="Servizi" description="Assistente virtuale, automazione d'ufficio, gestione intelligente dei documenti e contenuti con l'IA per le PMI italiane.">
  <PageHeader
    eyebrow="Servizi"
    title='Quattro servizi, <span class="text-gradient">un problema reale ciascuno.</span>'
    intro="Ognuno pensato per un problema che le PMI vivono ogni giorno. Sotto ogni servizio trovate una demo funzionante: provatela."
  >
    <nav class="mt-10 flex flex-wrap gap-2" aria-label="Servizi">
      {services.map((s) => <a href={`#${s.id}`} class="btn btn-secondary">{s.shortTitle}</a>)}
    </nav>
  </PageHeader>

  {
    services.map((s, i) => (
      <section id={s.id} class="container-page scroll-mt-24 border-t border-white/10 py-20">
        <div class="grid gap-10 lg:grid-cols-5" data-reveal>
          <div class="lg:col-span-3">
            <div class="flex items-center gap-4">
              <ServiceIcon name={s.icon} size="lg" />
              <span class="font-display text-sm text-slate-500">0{i + 1} / 0{services.length}</span>
            </div>
            <h2 class="mt-6 text-4xl">{s.title}</h2>
            <p class="mt-3 text-xl text-brand-100">{s.hook}</p>
            <p class="mt-4 text-lg text-slate-400">{s.description}</p>
          </div>
          <div class="lg:col-span-2">
            <ul class="space-y-3">
              {s.benefits.map((b) => (
                <li class="glass flex gap-3 rounded-2xl px-4 py-3 text-slate-200">
                  <span class="text-brand-300">✓</span>
                  {b}
                </li>
              ))}
            </ul>
            <p class="mt-5 rounded-2xl border-l-2 border-accent-400 bg-accent-400/5 px-4 py-3 text-sm text-slate-300">
              <span class="font-semibold text-accent-300">Esempio. </span>
              {s.example}
            </p>
          </div>
        </div>
        <div class="mt-12" data-reveal>
          <p class="mb-5 text-xs font-semibold tracking-[0.2em] text-slate-500 uppercase">Provatelo qui ↓</p>
          {s.id === 'assistente' && <DemoChat />}
          {s.id === 'ufficio' && <DemoFlow />}
          {s.id === 'documenti' && <DemoDocs />}
          {s.id === 'marketing' && <DemoContent />}
        </div>
        <a href={`${localizedPath('it', 'calculator')}?servizio=${s.id}`} class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-brand-300 hover:text-brand-200">
          Calcolate quanto vale per voi →
        </a>
      </section>
    ))
  }

  <CtaBand />
</Base>
