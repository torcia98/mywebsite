---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import { localizedPath } from '../i18n/ui';

const demoMode = !site.formEndpoint;
const input =
  'mt-1 block w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-slate-900 shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none';
const label = 'block text-sm font-medium text-slate-800';
---

<Base title="Contatti" description="Prenota una call gratuita o scrivici: ti rispondiamo entro un giorno lavorativo.">
  <PageHeader
    eyebrow="Contatti"
    title="Prenota una call gratuita"
    intro="Raccontaci in due righe di cosa ti occupi e cosa vorresti migliorare. Ti ricontattiamo entro un giorno lavorativo per fissare una chiamata di 30 minuti."
  />

  <section id="prenota" class="container-page mt-16 grid scroll-mt-24 gap-12 lg:grid-cols-3">
    <form
      class="space-y-5 rounded-3xl border border-slate-200 p-6 sm:p-8 lg:col-span-2"
      method="POST"
      action={site.formEndpoint || undefined}
      data-demo={demoMode ? 'true' : undefined}
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="nome" class={label}>Nome e cognome *</label>
          <input id="nome" name="nome" type="text" autocomplete="name" required class={input} />
        </div>
        <div>
          <label for="azienda" class={label}>Azienda *</label>
          <input id="azienda" name="azienda" type="text" autocomplete="organization" required class={input} />
        </div>
        <div>
          <label for="email" class={label}>Email *</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={input} />
        </div>
        <div>
          <label for="telefono" class={label}>Telefono</label>
          <input id="telefono" name="telefono" type="tel" autocomplete="tel" class={input} />
        </div>
        <div>
          <label for="dimensione" class={label}>Dimensione azienda</label>
          <select id="dimensione" name="dimensione" class={input}>
            <option value="">Seleziona…</option>
            <option>1–9 dipendenti</option>
            <option>10–49 dipendenti</option>
            <option>50–249 dipendenti</option>
            <option>250+ dipendenti</option>
          </select>
        </div>
        <div>
          <label for="interesse" class={label}>Area di interesse</label>
          <select id="interesse" name="interesse" class={input}>
            <option value="">Seleziona…</option>
            {services.map((s) => <option>{s.title}</option>)}
            <option>Non lo so ancora</option>
          </select>
        </div>
      </div>

      <fieldset>
        <legend class={label}>Quando preferisci essere ricontattato?</legend>
        <div class="mt-2 flex flex-wrap gap-4 text-sm text-slate-700">
          <label class="flex items-center gap-2"><input type="radio" name="fascia" value="mattina" class="accent-brand-600" /> Mattina</label>
          <label class="flex items-center gap-2"><input type="radio" name="fascia" value="pomeriggio" class="accent-brand-600" /> Pomeriggio</label>
          <label class="flex items-center gap-2"><input type="radio" name="fascia" value="indifferente" class="accent-brand-600" checked /> Indifferente</label>
        </div>
      </fieldset>

      <div>
        <label for="messaggio" class={label}>Di cosa vorresti parlare? *</label>
        <textarea
          id="messaggio"
          name="messaggio"
          rows="5"
          required
          class={input}
          placeholder="Es. riceviamo 200 email al giorno con richieste di preventivo e vorremmo velocizzare le risposte."
        ></textarea>
      </div>

      <!-- Honeypot anti-spam: hidden from people, filled by bots -->
      <div class="hidden" aria-hidden="true">
        <label>Lascia vuoto <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>

      <label class="flex items-start gap-3 text-sm text-slate-600">
        <input type="checkbox" name="privacy" required class="mt-1 accent-brand-600" />
        <span>
          Ho letto l’<a href={localizedPath('it', 'privacy')} class="text-brand-700 underline">informativa privacy</a> e
          acconsento al trattamento dei miei dati per essere ricontattato. *
        </span>
      </label>

      <div class="flex flex-wrap items-center gap-4">
        <button type="submit" class="btn btn-primary">Invia richiesta</button>
        <p class="text-xs text-slate-500">* campi obbligatori</p>
      </div>
      <p data-form-status class="hidden rounded-xl bg-brand-50 p-4 text-sm text-brand-800" role="status"></p>
    </form>

    <aside class="space-y-6">
      {
        site.bookingUrl && (
          <div class="rounded-3xl bg-brand-900 p-6 text-white">
            <h2 class="text-xl text-white">Preferisci scegliere tu l’orario?</h2>
            <p class="mt-2 text-sm text-brand-100">Prenota direttamente uno slot libero nel nostro calendario.</p>
            <a href={site.bookingUrl} class="btn mt-4 bg-accent-400 text-slate-900 hover:bg-accent-500" rel="noopener" target="_blank">
              Apri il calendario
            </a>
          </div>
        )
      }
      <div class="rounded-3xl bg-slate-50 p-6">
        <h2 class="text-xl">Contatti diretti</h2>
        <ul class="mt-4 space-y-3 text-slate-700">
          <li><span class="block text-xs uppercase tracking-wider text-slate-500">Email</span><a class="hover:text-brand-700" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li><span class="block text-xs uppercase tracking-wider text-slate-500">Telefono</span><a class="hover:text-brand-700" href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a></li>
          <li><span class="block text-xs uppercase tracking-wider text-slate-500">WhatsApp</span><a class="hover:text-brand-700" href={site.contact.whatsapp} rel="noopener">Scrivici su WhatsApp</a></li>
          <li><span class="block text-xs uppercase tracking-wider text-slate-500">Sede</span>{site.legal.address}</li>
        </ul>
      </div>
      <div class="rounded-3xl border border-slate-200 p-6 text-sm text-slate-600">
        <h2 class="text-base">Cosa succede dopo?</h2>
        <ol class="mt-3 list-decimal space-y-1 pl-5">
          <li>Leggiamo la tua richiesta.</li>
          <li>Ti scriviamo per fissare una call di 30 minuti.</li>
          <li>Ti inviamo una prima valutazione, gratis.</li>
        </ol>
      </div>
    </aside>
  </section>
</Base>

<script>
  // In demo mode (no form endpoint configured) we don't send data anywhere:
  // just show a confirmation so the flow can be reviewed.
  const form = document.querySelector<HTMLFormElement>('form[data-demo]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    if (status) {
      status.textContent =
        'Modalità demo: nessun dato è stato inviato. Configura "formEndpoint" in src/config/site.ts per ricevere le richieste.';
      status.classList.remove('hidden');
    }
  });
</script>
