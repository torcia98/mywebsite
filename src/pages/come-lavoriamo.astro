---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  {
    n: '01',
    title: 'Call conoscitiva (gratuita)',
    time: '30 minuti',
    text: 'Ci raccontate la vostra azienda e le attività che vi rubano più tempo. Vi diciamo subito dove l’AI può aiutare e dove no.',
  },
  {
    n: '02',
    title: 'Analisi e proposta',
    time: '1 settimana',
    text: 'Mappiamo il processo scelto, stimiamo tempo risparmiato e costi, e vi presentiamo una proposta a prezzo chiaro, senza sorprese.',
  },
  {
    n: '03',
    title: 'Progetto pilota',
    time: '2–4 settimane',
    text: 'Realizziamo la prima automazione su un caso reale, la colleghiamo ai vostri strumenti e la proviamo insieme al vostro team.',
  },
  {
    n: '04',
    title: 'Avvio e formazione',
    time: '1 settimana',
    text: 'Mettiamo in produzione, formiamo le persone che la useranno e lasciamo una documentazione semplice, in italiano.',
  },
  {
    n: '05',
    title: 'Assistenza e miglioramento',
    time: 'continuativo',
    text: 'Monitoriamo i risultati, interveniamo se qualcosa cambia e proponiamo i passi successivi solo quando hanno senso.',
  },
];

const principles = [
  { title: 'Semplicità prima di tutto', text: 'Usiamo la soluzione più semplice che funziona. Niente tecnologia fine a sé stessa.' },
  { title: 'Persone al centro', text: 'L’AI toglie il lavoro ripetitivo, le decisioni importanti restano alle persone.' },
  { title: 'Privacy by design', text: 'Dati trattati secondo il GDPR, preferibilmente su infrastrutture in Unione Europea.' },
  { title: 'Risultati misurabili', text: 'Per ogni progetto fissiamo indicatori chiari: ore risparmiate, tempi di risposta, errori evitati.' },
];
---

<Base title="Come lavoriamo" description="Il nostro metodo: dalla call gratuita al progetto pilota, fino all'assistenza continua.">
  <PageHeader
    eyebrow="Come lavoriamo"
    title="Un metodo graduale, pensato per le piccole e medie imprese"
    intro="Partiamo in piccolo, dimostriamo il valore, poi cresciamo insieme. Ogni passo è chiaro nei tempi e nei costi."
  />

  <section class="container-page mt-16">
    <ol class="relative space-y-8 border-l-2 border-brand-400/30 pl-8">
      {
        steps.map((s) => (
          <li class="relative">
            <span class="absolute top-1 -left-[2.6rem] flex size-8 items-center justify-center rounded-full bg-brand-400 text-xs font-semibold text-ink-950 shadow-[0_0_20px] shadow-brand-400/50">
              {s.n}
            </span>
            <div class="spotlight glass rounded-2xl p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-xl">{s.title}</h2>
                <span class="text-sm font-medium text-accent-300">{s.time}</span>
              </div>
              <p class="mt-2 text-slate-400">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-page mt-24">
    <h2 class="text-3xl">I nostri principi</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        principles.map((p) => (
          <div class="rounded-2xl bg-white/[0.03] p-6">
            <h3 class="text-lg">{p.title}</h3>
            <p class="mt-2 text-slate-400">{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>
