---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import Founder from '../components/human/Founder.astro';

const values = [
  { title: 'Parliamo italiano, non “tecnichese”', text: 'Spieghiamo cosa facciamo con parole semplici e risultati concreti.' },
  { title: 'Vicini al territorio', text: 'Conosciamo le PMI italiane: fatturazione elettronica, gestionali, filiere e abitudini.' },
  { title: 'Trasparenza', text: 'Prezzi chiari, nessun vincolo nascosto, e vi diciamo quando l’AI non è la risposta giusta.' },
];
---

<Base title="Chi siamo" description={`Chi siamo: chi c'è dietro ${site.name} e perché aiutiamo le PMI italiane con l'AI.`}>
  <PageHeader
    eyebrow="Chi siamo"
    title="Portiamo l’intelligenza artificiale nelle PMI, senza complicazioni"
    intro={`${site.name} nasce da un’idea semplice: le tecnologie che usano le grandi aziende possono aiutare anche le piccole, se sono progettate su misura e spiegate bene.`}
  />

  <section class="container-page mt-16 grid gap-12 lg:grid-cols-2">
    <div class="space-y-4 text-lg text-slate-700">
      <h2 class="text-3xl">La nostra missione</h2>
      <p>
        Le piccole e medie imprese sono la spina dorsale dell’economia italiana, ma spesso hanno poco tempo e poche
        persone per innovare. Noi ci occupiamo della parte tecnica, così voi potete concentrarvi su clienti, prodotti e
        crescita.
      </p>
      <p>
        Lavoriamo con aziende di servizi, commercio, artigianato, studi professionali e manifattura in tutta Italia, in
        presenza e da remoto.
      </p>
          </div>
    <div class="grid gap-4">
      {
        values.map((v) => (
          <div class="spotlight glass rounded-2xl p-6">
            <h3 class="text-lg">{v.title}</h3>
            <p class="mt-2 text-slate-600">{v.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-light mt-24 py-28">
    <div class="container-page"><Founder /></div>
  </section>

  <CtaBand />
</Base>
