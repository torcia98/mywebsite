---
import { localizedPath, getLangFromUrl } from '../i18n/ui';
interface Props {
  title?: string;
  text?: string;
}
const lang = getLangFromUrl(Astro.url);
const {
  title = 'Scopriamo insieme cosa può fare l’IA per la vostra impresa',
  text = 'In 30 minuti, senza impegno, analizziamo la vostra attività e vi indichiamo le due o tre automazioni che possono farvi risparmiare più tempo.',
} = Astro.props;
---

<section class="container-page mt-32" data-reveal>
  <div class="relative overflow-hidden rounded-[2rem] border border-ink-900/10 px-6 py-16 text-center sm:px-12">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-terra-300/40 via-white to-accent-300/40"></div>
    <div class="animate-aurora absolute -top-1/2 left-1/4 -z-10 size-[30rem] rounded-full bg-terra-300/30 blur-[100px]"></div>
    <div class="grid-bg absolute inset-0 -z-10 opacity-60"></div>
    <h2 class="mx-auto max-w-3xl text-3xl sm:text-5xl">{title}</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-slate-700">{text}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={localizedPath(lang, 'contact')} class="btn btn-primary px-7 py-3 text-base">Prenota la consulenza gratuita</a>
      <a href={localizedPath(lang, 'calculator')} class="btn btn-secondary px-7 py-3 text-base">Calcolate il vostro risparmio</a>
    </div>
  </div>
</section>
