---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="border-b border-slate-200 bg-gradient-to-b from-brand-50 to-white">
  <div class="container-page py-16 sm:py-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl text-4xl sm:text-5xl">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-lg text-slate-600">{intro}</p>}
  </div>
</section>
