---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-hidden pt-36 pb-16 sm:pt-44 sm:pb-20">
  <div class="grid-bg absolute inset-0 -z-10"></div>
  <div class="absolute -top-40 left-1/2 -z-10 h-[30rem] w-[50rem] -translate-x-1/2 rounded-full bg-brand-500/20 blur-[120px]"></div>
  <div class="container-page">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-5 max-w-4xl text-4xl leading-[1.05] sm:text-6xl">
      <Fragment set:html={title} />
    </h1>
    {intro && <p class="mt-6 max-w-2xl text-lg text-slate-400">{intro}</p>}
    <slot />
  </div>
</section>
