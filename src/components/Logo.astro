---
import { site } from '../config/site';
---

<span class="inline-flex items-center gap-2.5 font-display font-semibold text-white">
  <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#4df3e2"></stop>
        <stop offset="1" stop-color="#8b5cf6"></stop>
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#logo-g)"></rect>
    <path d="M9 22 L16 9 L23 22" fill="none" stroke="#05070d" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="16" cy="19" r="2.3" fill="#05070d"></circle>
  </svg>
  <span class="text-lg tracking-tight">{site.name}</span>
</span>
