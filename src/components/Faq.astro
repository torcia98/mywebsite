---
import { faq } from '../data/faq';
---

<div class="divide-y divide-ink-900/10 rounded-3xl border border-ink-900/10 bg-white">
  {
    faq.map((f) => (
      <details class="group px-6 py-5 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-ink-900">
          {f.q}
          <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-ink-900/15 text-terra-600 transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 max-w-3xl text-slate-600">{f.a}</p>
      </details>
    ))
  }
</div>
