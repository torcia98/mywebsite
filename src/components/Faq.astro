---
import { faq } from '../data/faq';
---

<div class="divide-y divide-white/10 rounded-3xl border border-white/10 bg-white/[0.02]">
  {
    faq.map((f) => (
      <details class="group px-6 py-5 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-white">
          {f.q}
          <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-white/15 text-brand-300 transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 max-w-3xl text-slate-400">{f.a}</p>
      </details>
    ))
  }
</div>
