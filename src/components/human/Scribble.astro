---
/**
 * Handwritten note with a hand-drawn arrow, for a personal touch next to demos and sections.
 * arrow: direction the arrow points to.
 */
interface Props {
  text: string;
  arrow?: 'down' | 'left' | 'right' | 'down-left' | 'down-right' | 'none';
  tone?: 'warm' | 'brand' | 'dark';
  rotate?: number;
  class?: string;
}
const { text, arrow = 'down-right', tone = 'warm', rotate = -3, class: cls = '' } = Astro.props;
const color = tone === 'warm' ? 'text-accent-300' : tone === 'brand' ? 'text-brand-300' : 'text-terra-500';
const paths: Record<string, string> = {
  down: 'M20 4 C 26 22, 14 34, 22 54 M14 44 L22 56 L30 45',
  left: 'M58 18 C 40 8, 22 26, 6 20 M16 12 L5 20 L16 28',
  right: 'M4 20 C 22 6, 40 30, 58 18 M48 10 L59 18 L49 27',
  'down-left': 'M56 4 C 50 26, 30 40, 8 48 M12 36 L6 49 L20 52',
  'down-right': 'M6 4 C 12 26, 32 40, 54 48 M42 52 L56 49 L50 36',
  none: '',
};
---

<span
  class:list={['pointer-events-none inline-flex select-none items-start gap-1 font-hand text-2xl leading-none', color, cls]}
  style={`transform: rotate(${rotate}deg)`}
  aria-hidden="true"
>
  {arrow === 'left' && <svg width="62" height="40" viewBox="0 0 62 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={paths.left} /></svg>}
  <span class="whitespace-nowrap">{text}</span>
  {arrow !== 'left' && arrow !== 'none' && (
    <svg width="62" height="60" viewBox="0 0 62 60" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-3 shrink-0">
      <path d={paths[arrow]} />
    </svg>
  )}
</span>
