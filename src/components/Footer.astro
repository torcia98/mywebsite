---
import Logo from './Logo.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const linkCls = 'hover:text-white transition-colors';
---

<footer class="relative mt-32 border-t border-white/10 bg-ink-900">
  <div class="pointer-events-none absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-brand-400/60 to-transparent"></div>
  <div class="container-page grid gap-10 py-14 md:grid-cols-5">
    <div class="md:col-span-2">
      <Logo />
      <p class="mt-4 max-w-sm text-sm text-slate-400">{site.tagline}. Automazioni concrete, spiegate in italiano semplice.</p>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">{t('nav.services')}</p>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        {services.map((s) => <li><a class={linkCls} href={`${localizedPath(lang, 'services')}#${s.id}`}>{s.shortTitle}</a></li>)}
        <li><a class={linkCls} href={localizedPath(lang, 'calculator')}>{t('nav.calculator')}</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">{t('nav.contact')}</p>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        <li><a class={linkCls} href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><a class={linkCls} href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a></li>
        <li><a class={linkCls} href={site.contact.whatsapp} rel="noopener">WhatsApp</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-white">{t('footer.legal')}</p>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        <li><a class={linkCls} href={localizedPath(lang, 'privacy')}>{t('footer.privacy')}</a></li>
        <li><a class={linkCls} href={localizedPath(lang, 'cookie')}>{t('footer.cookie')}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/5">
    <div class="container-page flex flex-col gap-1 py-5 text-xs text-slate-500 sm:flex-row sm:justify-between">
      <p>© {year} {site.legal.companyName.replace(/\.$/, '')}. {t('footer.rights')}</p>
      <p>{site.legal.vat} · {site.legal.address}</p>
    </div>
  </div>
</footer>
