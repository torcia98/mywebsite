---
import Logo from './Logo.astro';
import { site } from '../config/site';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-slate-200 bg-slate-50">
  <div class="container-page grid gap-10 py-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <Logo />
      <p class="mt-3 max-w-sm text-sm text-slate-600">{site.tagline}.</p>
    </div>
    <div>
      <p class="text-sm font-semibold text-slate-900">{t('nav.contact')}</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a class="hover:text-brand-700" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><a class="hover:text-brand-700" href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a></li>
        <li><a class="hover:text-brand-700" href={site.contact.whatsapp} rel="noopener">WhatsApp</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-slate-900">{t('footer.legal')}</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a class="hover:text-brand-700" href={localizedPath(lang, 'privacy')}>{t('footer.privacy')}</a></li>
        <li><a class="hover:text-brand-700" href={localizedPath(lang, 'cookie')}>{t('footer.cookie')}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200">
    <div class="container-page flex flex-col gap-1 py-5 text-xs text-slate-500 sm:flex-row sm:justify-between">
      <p>© {year} {site.legal.companyName.replace(/\.$/, "")}. {t('footer.rights')}</p>
      <p>{site.legal.vat} · {site.legal.address}</p>
    </div>
  </div>
</footer>
