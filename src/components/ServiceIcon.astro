---
import type { IconName } from '../data/services';
interface Props {
  name: IconName;
  size?: 'md' | 'lg';
}
const { name, size = 'md' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center justify-center rounded-2xl border border-terra-400/25 bg-gradient-to-br from-terra-300/30 to-accent-300/25 text-terra-600',
    size === 'lg' ? 'size-14' : 'size-11',
  ]}
>
  <svg class={size === 'lg' ? 'size-7' : 'size-5'} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {name === 'chat' && <path d="M21 12a8 8 0 0 1-11.8 7L4 20l1-4.6A8 8 0 1 1 21 12zM8.5 12h.01M12 12h.01M15.5 12h.01" />}
    {name === 'doc' && <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h4" />}
    {name === 'flow' && <path d="M6 3v6m0 0a3 3 0 1 0 0 6m0-6a3 3 0 1 1 0 6m0 0v6M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm0 0v3a3 3 0 0 1-3 3H9" />}
    {name === 'spark' && <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z" />}
  </svg>
</span>
