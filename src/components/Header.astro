---
import Logo from './Logo.astro';
import {
  getLangFromUrl,
  useTranslations,
  localizedPath,
  languages,
  routes,
  showLanguageSwitcher,
  type Lang,
} from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: localizedPath(lang, 'services'), label: t('nav.services') },
  { href: localizedPath(lang, 'method'), label: t('nav.method') },
  { href: localizedPath(lang, 'about'), label: t('nav.about') },
  { href: localizedPath(lang, 'contact'), label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={localizedPath(lang, 'home')} aria-label="Home"><Logo /></a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Principale">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-brand-700',
              current === l.href ? 'text-brand-700' : 'text-slate-600',
            ]}
            aria-current={current === l.href ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      {
        showLanguageSwitcher && (
          <div class="flex gap-2 text-sm">
            {(Object.keys(languages) as Lang[]).map((l) => (
              <a href={routes[l].home} class:list={[l === lang ? 'font-semibold' : 'text-slate-500']}>
                {l.toUpperCase()}
              </a>
            ))}
          </div>
        )
      }
      <a href={localizedPath(lang, 'contact') + '#prenota'} class="btn btn-primary">{t('nav.cta')}</a>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-slate-300 px-4 py-2 text-sm font-medium [&::-webkit-details-marker]:hidden"
      >
        {t('nav.menu')}
        <svg class="size-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z"></path>
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-2 flex w-60 flex-col gap-1 rounded-2xl border border-slate-200 bg-white p-3 shadow-lg"
        aria-label="Mobile"
      >
        {
          links.map((l) => (
            <a href={l.href} class="rounded-lg px-3 py-2 text-sm font-medium hover:bg-slate-50">
              {l.label}
            </a>
          ))
        }
        <a href={localizedPath(lang, 'contact') + '#prenota'} class="btn btn-primary mt-2">{t('nav.cta')}</a>
      </nav>
    </details>
  </div>
</header>
